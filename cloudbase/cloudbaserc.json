{
  "version": "2.0",
  "envId": "请替换为 CloudBase 环境 ID",
  "functionRoot": "./functions",
  "functions": [
    {
      "name": "whoop-cron",
      "handler": "index.main",
      "runtime": "Nodejs18.15",
      "timeout": 300,
      "installDependency": false,
      "envVariables": {
        "WHOOP_SITE_URL": "请替换为网站 https 地址",
        "CRON_SECRET": "请替换为与网站相同的 CRON_SECRET"
      },
      "triggers": [
        { "name": "whoop-9-12", "type": "timer", "config": "0 0 9,12 * * * *" }
      ]
    }
  ]
}
